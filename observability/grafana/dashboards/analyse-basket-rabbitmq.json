          "legendFormat": "channels"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Memory used",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rabbitmq_node_mem_used",
          "legendFormat": "{{instance}}"

      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Disk free",
      "gridPos": {
        "x": 8,
        "y": 28,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rabbitmq_node_disk_free",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Memory / disk alarms",
      "gridPos": {
        "x": 16,
        "y": 28,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "rabbitmq_node_mem_alarm",
          "legendFormat": "memory alarm {{instance}}"
        },
        {
          "expr": "rabbitmq_node_disk_free_alarm",
          "legendFormat": "disk alarm {{instance}}"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Saturation indicators",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rabbitmq_queue_messages_unacked)",
          "legendFormat": "unacked"
        },
        {
          "expr": "sum(rabbitmq_queue_messages_ready)",
          "legendFormat": "ready"
        },
        {
          "expr": "sum(rabbitmq_queue_messages) / clamp_min(sum(rabbitmq_queue_consumers), 1)",
          "legendFormat": "messages per consumer"
        }
      ]
    }

    {
      "id": 6,
      "type": "stat",
      "title": "Alarms",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rabbitmq_node_mem_alarm) + sum(rabbitmq_node_disk_free_alarm)",
          "legendFormat": "alarms"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Messages ready / unacked / total",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rabbitmq_queue_messages_ready)",
          "legendFormat": "ready"
        },
        {
          "expr": "sum(rabbitmq_queue_messages_unacked)",
          "legendFormat": "unacked"
        },
        {
          "expr": "sum(rabbitmq_queue_messages)",
          "legendFormat": "total"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Message rates publish / deliver-get / ack",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(rabbitmq_global_messages_published_total[5m]))",
          "legendFormat": "publish/s"
        },
        {
          "expr": "sum(rate(rabbitmq_global_messages_delivered_total[5m])) or (sum(rate(rabbitmq_global_messages_delivered_consume_auto_ack_total[5m])) + sum(rate(rabbitmq_global_messages_delivered_consume_manual_ack_total[5m])) + sum(rate(rabbitmq_global_messages_delivered_get_auto_ack_total[5m])) + sum(rate(rabbitmq_global_messages_delivered_get_manual_ack_total[5m])))",
          "legendFormat": "deliver/get/s"
        },
        {
          "expr": "sum(rate(rabbitmq_global_messages_acknowledged_total[5m]))",
          "legendFormat": "ack/s"
        }
      ]
    },
    {
      "id": 9,
      "type": "barchart",
      "title": "Top queues by ready messages",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "topk(10, sum by (queue, vhost) (rabbitmq_queue_messages_ready))",
          "legendFormat": "{{vhost}}/{{queue}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "barchart",
      "title": "Top queues by unacked messages",
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "topk(10, sum by (queue, vhost) (rabbitmq_queue_messages_unacked))",
          "legendFormat": "{{vhost}}/{{queue}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "barchart",
      "title": "Top queues by consumers",
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "topk(10, sum by (queue, vhost) (rabbitmq_queue_consumers))",
          "legendFormat": "{{vhost}}/{{queue}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Queue depth over time",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (queue) (rabbitmq_queue_messages)",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Consumers / connections / channels",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rabbitmq_queue_consumers)",
          "legendFormat": "consumers"
        },
        {
          "expr": "sum(rabbitmq_connections)",
          "legendFormat": "connections"
        },
        {

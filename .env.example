# Docker images (set to your registry/tag conventions)
FRONT_IMAGE=front-service:local
AUTH_IMAGE=auth-service:local

# Internal container ports (must match each service runtime)
FRONT_INTERNAL_PORT=4200
AUTH_INTERNAL_PORT=3000

# Traefik published ports (Traefik is the only default HTTP entrypoint)
TRAEFIK_WEB_PORT=80
TRAEFIK_DASHBOARD_PORT=8080

# Optional direct debug mode for auth only (docker-compose.direct.yml)
AUTH_HOST_PORT=3001

# Watchtower polling interval in seconds (DEV/staging only)
WATCHTOWER_POLL_INTERVAL=30

# Images
FRONT_IMAGE=front-service:local
AUTH_IMAGE=auth-service:local

# Internal container ports (adjust to real service ports)
FRONT_INTERNAL_PORT=4200
AUTH_INTERNAL_PORT=3000

# Traefik published ports
TRAEFIK_WEB_PORT=80
TRAEFIK_DASHBOARD_PORT=8080

# Direct debug mode only (docker-compose.direct.yml)
AUTH_HOST_PORT=3001

# Watchtower (DEV/staging only)
WATCHTOWER_POLL_INTERVAL=30

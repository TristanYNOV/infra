# --- Traefik entrypoint ---
TRAEFIK_WEB_PORT=80
TRAEFIK_DASHBOARD_PORT=8080

# --- GHCR images ---
# Each variable must contain the FULL image reference.
# Accepted formats:
# - ghcr.io/<owner>/<repo>:<tag>
# - ghcr.io/<owner>/<repo>@sha256:<digest>
# Prefer immutable digests in production when available.
# Until immutable refs are available, tags are accepted.
FRONT_IMAGE=ghcr.io/tristanynov/front-service:prod
AUTH_IMAGE=ghcr.io/tristanynov/auth-service:prod
ANALYSIS_STORE_IMAGE=ghcr.io/tristanynov/analysis-store-service:prod

# --- auth-service runtime (from auth infra contract) ---
AUTH_NODE_ENV=production
AUTH_STRICT_ENV=true
AUTH_DATABASE_URL=mongodb://mongo:27017
AUTH_DB_NAME=auth_db
AUTH_JWT_SECRET=__CHANGE_ME_TO_A_STRONG_SECRET__
AUTH_JWT_EXPIRES_IN=15m
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
AUTH_SALT=10
AUTH_ADMIN_EMAIL=__CHANGE_ME__
AUTH_ADMIN_PASSWORD=__CHANGE_ME__
AUTH_ADMIN_PSEUDO=admin

# --- analysis-store-service runtime (from analysis-store infra contract) ---
# Required when running with profile "analysis-store":
#   docker compose --profile analysis-store up -d
ANALYSIS_STORE_NODE_ENV=production
ANALYSIS_STORE_MASTER_KEY=__CHANGE_ME_TO_A_32_BYTES_MASTER_KEY__
ANALYSIS_STORE_CRYPTO_KEY_VERSION=v1
ANALYSIS_STORE_DB_NAME=analysis_store
ANALYSIS_STORE_DB_USER=analysis_store
ANALYSIS_STORE_DB_PASSWORD=__CHANGE_ME__
# Optional explicit override. By default compose builds the URL from DB vars above.
# ANALYSIS_STORE_DATABASE_URL=postgres://analysis_store:<password>@postgres:5432/analysis_store

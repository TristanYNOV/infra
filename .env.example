# --- Traefik entrypoint ---
TRAEFIK_WEB_PORT=80
TRAEFIK_DASHBOARD_PORT=8080

# --- GHCR private images (prefer digest pinning) ---
# Examples:
# FRONT_IMAGE=ghcr.io/tristanynov/front-service@sha256:<digest>
# AUTH_IMAGE=ghcr.io/tristanynov/auth-service@sha256:<digest>
# Fallback possible: :prod tag
FRONT_IMAGE=ghcr.io/tristanynov/front-service:prod
AUTH_IMAGE=ghcr.io/tristanynov/auth-service:prod

# --- auth-service runtime (from auth infra contract) ---
AUTH_NODE_ENV=production
AUTH_STRICT_ENV=true
AUTH_DATABASE_URL=mongodb://mongo:27017
AUTH_DB_NAME=auth_db
AUTH_JWT_SECRET=__CHANGE_ME_TO_A_STRONG_SECRET__
AUTH_JWT_EXPIRES_IN=15m
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
AUTH_SALT=10
AUTH_ADMIN_EMAIL=__CHANGE_ME__
AUTH_ADMIN_PASSWORD=__CHANGE_ME__
AUTH_ADMIN_PSEUDO=admin

{
  "info": {
    "name": "Analyse Basket - infra",
    "_postman_id": "af70604d-1140-4ca5-bf17-ff2c5154fd31",
    "description": "Collection globale pour tester la stack via infra/Traefik, y compris le workflow RabbitMQ de suppression utilisateur.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const useGateway = String(pm.environment.get('useGateway') || 'true') === 'true';",
          "const gatewayBaseUrl = pm.environment.get('gatewayBaseUrl') || 'http://localhost';",
          "pm.collectionVariables.set('authBaseUrl', useGateway ? gatewayBaseUrl : pm.environment.get('authDirectBaseUrl'));",
          "pm.collectionVariables.set('analysisBaseUrl', useGateway ? `${gatewayBaseUrl}/analysis` : pm.environment.get('analysisDirectBaseUrl'));",
          "pm.collectionVariables.set('frontBaseUrl', gatewayBaseUrl);",
          "const requestName = pm.info.requestName || '';",
          "const isRabbit = requestName.startsWith('RabbitMQ -');",
          "const isAdmin = requestName.startsWith('Admin -');",
          "const isDeletionCandidate = requestName.includes('deletion candidate') || requestName.includes('Deletion candidate');",
          "let tokenKey = isAdmin ? 'accessTokenAdmin' : 'accessTokenUser';",
          "if (isDeletionCandidate) tokenKey = 'accessTokenDeletionCandidate';",
          "const token = pm.collectionVariables.get(tokenKey);",
          "if (token && !isRabbit) {",
          "  pm.request.headers.upsert({ key: 'Authorization', value: `Bearer ${token}` });",
          "}",
          "if (!useGateway && requestName.startsWith('Analysis -')) {",
          "  const userId = isDeletionCandidate ? pm.collectionVariables.get('deletionCandidateUserId') : pm.collectionVariables.get('userId');",
          "  if (userId) pm.request.headers.upsert({ key: 'x-auth-user-id', value: userId });",
          "  pm.request.headers.upsert({ key: 'x-auth-club-ids', value: pm.environment.get('clubIds') || '' });",
          "  pm.request.headers.upsert({ key: 'x-auth-roles', value: isAdmin ? 'admin' : 'user' });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "authBaseUrl", "value": "http://localhost" },
    { "key": "analysisBaseUrl", "value": "http://localhost/analysis" },
    { "key": "frontBaseUrl", "value": "http://localhost" }
